# Copy this file to .env and fill in your values
# Never commit .env to git (it's in .gitignore)

# Required
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPOS=spring-projects/spring-boot,docker/compose

# MongoDB (local default works for development)
MONGODB_URI=mongodb://localhost:27017/devpulse

# Alerting - Email (optional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=your@email.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password

# Alerting - Slack (optional)
ALERT_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Thresholds (optional - these are the defaults)
ALERT_STALE_PR_DAYS=7
ALERT_HEALTH_MIN=60
ALERT_OPEN_ISSUES_MAX=50

# Scheduler (optional - default: every 15 min)
SCRAPER_CRON=0 */15 * * * *
